[TEMPLATE]
# Jarvis Environment Configuration
# Copy this to .env and fill in your API keys

# Gemini AI (required for intelligent responses)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (optional — fallback AI provider)
GROQ_API_KEY=your_groq_api_key_here

# Composio (required for Google integrations)
# Get yours at: https://dashboard.composio.dev
COMPOSIO_API_KEY=your_composio_api_key_here

# ── Optional: extra free fallback providers ──────────────
# Any of these with a key automatically joins the fallback chain
# (order defined in config.py FALLBACK_PROVIDERS).
# Keys/sources: https://github.com/open-free-llm-api/awesome-freellm-apis
# NVIDIA NIM (128 free models): https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=your_nvidia_api_key_here
# OpenRouter (31 free models): https://openrouter.ai/workspaces/default/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# Cerebras (fastest free inference): https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=...
# Mistral (15 free models): https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=...
# GitHub Models (with any GitHub account): https://github.com/marketplace/models
# GITHUB_API_KEY=...
# SambaNova: https://cloud.sambanova.ai/apis
# SAMBANOVA_API_KEY=...
